# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. EVERY value is optional — with none of them set,
# the demo runs fully offline against mock tools and a scripted LLM provider.
# ---------------------------------------------------------------------------

# --- Execution mode --------------------------------------------------------
# mock     = scripted deterministic LLM, no network. Default. Use for rehearsal.
# direct   = Azure OpenAI chat.completions with function calling.
# foundry  = AI Foundry named agents + connected-agent handoff.
TRIAGE_PROVIDER_MODE=mock

# Which tool implementations to bind. mock = in-memory fakes, live = real REST.
# You can mix: TRIAGE_TOOL_MODE=live but TRIAGE_PROVIDER_MODE=mock is a valid
# rehearsal combination (real refreshes, deterministic reasoning).
TRIAGE_TOOL_MODE=mock

# --- Azure AI Foundry ------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://bitriage-foundry-eus.services.ai.azure.com/api/projects/bi-request-triage
FOUNDRY_TRIAGE_AGENT_NAME=bi-triage
FOUNDRY_DQ_AGENT_NAME=bi-data-quality
FOUNDRY_AGENT_MODEL=gpt-5.6-luna
FOUNDRY_GUARDRAIL_NAME=bi-triage-guardrail
# responses = orchestrator invokes the DQ agent over /openai/v1/responses, so
#             the PolicyLedger charges the handoff. Verified working.
# a2a       = Foundry's a2a_preview tool. Requires the callee to be a HOSTED
#             agent speaking the 'a2a' protocol; a prompt agent publishes no
#             agent card and the call fails at card fetch.
FOUNDRY_HANDOFF_MODE=responses

# --- Azure OpenAI (direct mode) --------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Microsoft Graph (inbox ingestion) -------------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=bi-alerts@contoso.com
# poll = timer-driven (simple, 1-5 min latency)
# subscription = Graph change notifications (event-driven, needs public HTTPS)
GRAPH_INGESTION_MODE=poll
GRAPH_POLL_SECONDS=30

# --- Power BI REST ---------------------------------------------------------
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# --- Teams notification ----------------------------------------------------
# Incoming webhook is the lowest-friction demo path. Graph chat post is the
# production path; see docs/provisioning.md.
TEAMS_WEBHOOK_URL=
TEAMS_MODE=webhook

# --- Observability ---------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Policy overrides (controller-enforced limits) -------------------------
# Turn and tool-call budgets are shared across ALL agents in a run, not per
# agent. Observed worst case is 10 turns; the defaults leave headroom.
TRIAGE_MAX_LLM_TURNS=14
TRIAGE_MAX_TOOL_CALLS=20
TRIAGE_MAX_WRITE_ACTIONS=1
TRIAGE_MAX_TOKENS=80000
TRIAGE_TIMEOUT_SECONDS=300
